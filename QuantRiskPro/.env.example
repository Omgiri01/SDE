# Copy this to .env and fill in your values
# Get a free Polygon.io key at https://polygon.io/dashboard

POLYGON_API_KEY=your_polygon_api_key_here

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WATCH_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,GS,BAC

KAFKA_TOPIC_RAW_TICKS=raw.ticks
KAFKA_TOPIC_AGGREGATED=aggregated.ohlcv
KAFKA_TOPIC_PORTFOLIO_EVENTS=portfolio.events

TIMESCALE_DSN=postgresql://equitypulse:equitypulse_secret@localhost:5432/equitypulse
REDIS_URL=redis://localhost:6379/0
